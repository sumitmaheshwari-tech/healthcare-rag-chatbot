# ==========================================
# MedCare Assistant — Production Environment Template (.env.example)
# Copy this file to .env and fill in your private API keys.
# ==========================================

ENV=production
COOKIE_SECURE=false
PORT=8000

# Security Secrets (Generate using: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=your_256_bit_jwt_secret_here
ENCRYPTION_KEY=your_fernet_encryption_key_here

# Primary LLM Provider (Google Gemini Cloud TPUs)
LLM_PROVIDER=gemini
GOOGLE_API_KEY=your_google_gemini_api_key_here
LLM_MODEL=gemini-3.5-flash-lite

# Fallback LLM & 2048-dim Embeddings (NVIDIA Build)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b

# Tertiary Fallback LLM (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Admin Notifications Telegram Bot (@MedCare_11_Bot)
TELEGRAM_BOT_TOKEN=your_admin_telegram_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_admin_telegram_chat_id_here

# Dedicated Patient OTP Verification Bot (@MedCare_Verification_bot)
TELEGRAM_AUTH_BOT_TOKEN=your_auth_telegram_bot_token_here
TELEGRAM_AUTH_BOT_USERNAME=MedCare_Verification_bot

# Database & Chroma Persist Locations
DATABASE_URL=sqlite:///hospital.db
CHROMA_PERSIST_DIR=./chroma_db
