# 🏥 MedCare Assistant Local Ollama Modelfile
# This configures Llama 3.2 to run in low-latency, low-VRAM mode.

FROM llama3.2

# ── Parameters ────────────────────────────────────────────────
# Sets the context window to 4096 tokens (saves significant VRAM KV Cache)
PARAMETER num_ctx 4096

# Caps the generation length (prevents endless output loops)
PARAMETER num_predict 1024

# Disables creativity (makes database queries and scheduling deterministic)
PARAMETER temperature 0

# Stops generation instantly when the agent decides it is done
PARAMETER stop "<|eot_id|>"
PARAMETER stop "<|start_header_id|>"
PARAMETER stop "<|end_header_id|>"
