{
  "functions": {
    "api/index.py": {
      "includeFiles": "{backend/**,public/**,frontend/**}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py?__orig_path=/api/health"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__orig_path=/api/$1"
    },
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
